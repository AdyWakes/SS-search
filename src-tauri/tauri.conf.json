{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "shotfind",
  "version": "0.1.0",
  "identifier": "io.github.shotfind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "shotfind",
        "url": "index.html",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "backgroundColor": "#0f0f11"
      },
      {
        "label": "bar",
        "title": "shotfind quick search",
        "url": "index.html?view=bar",
        "width": 760,
        "height": 132,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true,
        "backgroundColor": "#0f0f11"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: thumb: http://thumb.localhost https://thumb.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Find any screenshot by typing what you remember. Offline.",
    "longDescription": "shotfind makes every screenshot and image on your computer searchable by the text inside it and by what it shows. Everything runs locally; nothing leaves your computer.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/onnxruntime/": "onnxruntime/"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    },
    "linux": {
      "deb": { "depends": [] }
    }
  }
}
